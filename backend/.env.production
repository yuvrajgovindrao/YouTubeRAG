# Environment
ENVIRONMENT=production

# Video Ingestion Cap (Hard cap of 5 videos on hosted demo)
MAX_VIDEOS_PER_COLLECTION=5

# Session Lifecycle (Sliding expiry: 2 hours = 7200 seconds)
SESSION_TTL_SECONDS=7200

# Rate Limiting & Abuse Protection
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_HOUR=10

# Google Gemini AI
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
GEMINI_CHAT_MODEL=gemini-1.5-flash

# Hosted Database (Azure PostgreSQL Flexible Server, Supabase, or Neon)
DATABASE_URL=postgresql+asyncpg://<username>:<password>@<host>:5432/<dbname>?ssl=require
SYNC_DATABASE_URL=postgresql://<username>:<password>@<host>:5432/<dbname>?ssl=require

# Retrieval Configuration
SIMILARITY_THRESHOLD=0.55
MAX_SOURCES_RETURNED=4

# Allowed Origins
CORS_ORIGINS=https://your-domain.azurecontainerapps.io
