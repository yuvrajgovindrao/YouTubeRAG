# Environment
ENVIRONMENT=development

# Video Ingestion Cap (Local dev has no restrictive cap)
MAX_VIDEOS_PER_COLLECTION=999

# Session Lifecycle (0 = disabled in local profile)
SESSION_TTL_SECONDS=0

# Rate Limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_HOUR=60

# Google Gemini AI
# Add your Gemini API key from https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
GEMINI_CHAT_MODEL=gemini-1.5-flash

# Database (PostgreSQL + pgvector container)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/youtube_rag
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/youtube_rag

# Retrieval Configuration
SIMILARITY_THRESHOLD=0.55
MAX_SOURCES_RETURNED=4

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
